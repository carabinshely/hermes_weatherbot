        "lifecycle_vectors": "../tests/lifecycle/manifest.json"
      },
      "support": {
        "allow_new_generation": true,
        "allow_new_ingestion": true,
        "allow_noncanonical_candidate_validation": true,
        "require_historical_read": true,
        "require_historical_hash_verification": true,
        "require_historical_signature_verification": true,
        "require_historical_replay": true
      },
      "schedule": {
        "announced_at": "2026-08-15T14:22:28.000000Z",
