# Hermes WeatherBot local environment
# Copy to .env only when optional local integrations need it. Never commit .env.

# Optional Visual Crossing key used only by the quarantined legacy resolution fallback.
VC_KEY=

# Optional Telegram notifications for local/operator tooling.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public producer operation requires no wallet, private key, signature type, approval,
# bankroll, position, or trading-ledger credential.

# Optional one-way PIP application-identity publication. Disabled by default.
# The signing key is a dedicated Ed25519 application-identity key with no financial authority.
HERMES_PIP_EXPORT_ENABLED=false
HERMES_PIP_ENDPOINT=
HERMES_PIP_OUTBOX_PATH=state/pip-outbox.sqlite3
HERMES_PIP_SIGNING_KEY_PATH=
HERMES_PIP_KEY_ID=
